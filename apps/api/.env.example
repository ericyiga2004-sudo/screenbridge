NODE_ENV=development
PORT=4000
# Comma-separated origins. In production set the exact Vercel HTTPS domain(s).
WEB_ORIGIN=http://localhost:5173
# Optional: screen sharing works without a database. Session audit only, never media.
MONGODB_URI=
# For connections across restricted networks, configure a real TURN service.
# TURN_URLS=turn:your-turn-server.com:3478,turns:your-turn-server.com:5349
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# LiveKit Cloud: set these on Render; never put the secret in Vercel or React.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
